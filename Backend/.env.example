PORT=5000
FRONTEND_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret
GEMINI_API_KEY=your_google_gemini_api_key_here
SEED_CSV=../GigCred_synthetic_10_users.csv
GCS_BUCKET=
ALLOW_DEMO_LOGIN=false

# Required for password-reset emails.
FRONTEND_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Recommended local setup: save the downloaded key at
# Backend/credentials/firebase-service-account.json and set this path.
# GOOGLE_APPLICATION_CREDENTIALS=./credentials/firebase-service-account.json
#
# Alternatively, provide the service-account fields below or use Application Default Credentials.
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-firebase-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
